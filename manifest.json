{
  "manifest_version": 3,
  "name": "LigaMagic - Captura local",
  "version": "1.1.0",
  "description": "Cotacoes LigaMagic e categorias filtradas do Scryfall Tagger em Excel. Captura manual e listas assistidas. Nao oficial.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "system.memory"],
  "optional_host_permissions": ["https://www.ligamagic.com.br/*", "https://ligamagic.com.br/*", "https://tagger.scryfall.com/*", "https://api.scryfall.com/*", "https://cards.scryfall.io/*"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "LigaMagic - Captura local",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.scryfall.com https://cards.scryfall.io"
  }
}